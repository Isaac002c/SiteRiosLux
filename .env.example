# As tags Google Ads AW-18060312094 e GA4 G-9X21JG8W4C já estão instaladas no código.
# Configure apenas um dos provedores abaixo. O GTM tem prioridade quando existe.
# Se usar GTM, configure o Google Ads dentro do contêiner para evitar tag duplicada.
NEXT_PUBLIC_GTM_ID=
# Preencha somente para substituir o ID padrão de GA4.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Integração server-side com o Rios Lux HUB. Nunca use prefixo NEXT_PUBLIC_.
RIOS_LUX_HUB_LEAD_ENDPOINT=
RIOS_LUX_HUB_TOKEN=
